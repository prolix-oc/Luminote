{
  "version": "1.0.0",
  "name": "Luminote",
  "identifier": "luminote",
  "author": "Prolix OCs",
  "github": "https://github.com/prolix-oc/luminote",
  "homepage": "https://github.com/prolix-oc/luminote",
  "description": "Coffee's Obsidian-style workspace for Lumiverse, published by Prolix OCs.",
  "permissions": [
    "app_manipulation",
