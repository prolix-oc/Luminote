{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "outDir": "./dist",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
